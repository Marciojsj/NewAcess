{
  "name": "accescontrol",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "npm run ensure-backend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --tunnel\"",
    "start:local": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start\"",
    "start:lan": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --lan\"",
    "start:frontend": "expo start --tunnel",
    "start:backend": "cd access-backend && npm run dev",
    "ensure-backend": "test -d access-backend || echo '⚠️  Backend não encontrado em access-backend'",
    "start:with-backend": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --tunnel\"",
    "start:only-frontend": "expo start --tunnel",
    "start:only-backend": "npm run start:backend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --tunnel -c\"",
    "android": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --android --tunnel\"",
    "ios": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --ios --tunnel\"",
    "web": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"expo start --web\"",
    "build": "expo build",
    "lint": "eslint src/**/*.{ts,tsx}",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:clear": "jest --clearCache",
    "pretest:crud": "npm run ensure-backend",
    "test:crud": "concurrently -k -s first -n \"BACKEND,TESTS\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run start:backend\" \"wait-on http://localhost:3000/api && jest __tests__/integration/crud.integration.test.ts --runInBand --detectOpenHandles\"",
    "test:crud:direct": "jest __tests__/integration/crud.integration.test.ts --runInBand --detectOpenHandles",
    "test:crud:watch": "jest __tests__/integration/crud.integration.test.ts --watch",
    "test:unit": "jest --testPathIgnorePatterns=integration --runInBand",
    "test:all": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-native-picker/picker": "^2.11.2",
    "@react-navigation/drawer": "^7.5.8",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-navigation/stack": "^7.4.8",
    "axios": "^1.12.2",
    "expo": "~54.0.12",
    "expo-camera": "~17.0.8",
    "expo-image-picker": "^17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.1.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "~0.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-bootstrap": "^1.0.1",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.12",
    "ts-jest": "^29.4.4",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.1"
  },
  "private": true
}
